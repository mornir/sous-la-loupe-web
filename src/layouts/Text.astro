---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
const { frontmatter } = Astro.props
---

<Layout title={frontmatter.title}>
  <div class="mt-8">
    <Header />
    <article
      class="prose md:prose-lg lg:prose-xl mx-auto mt-12 lg:mt-24 mb-32 prose-a:text-accent prose-img:mx-auto prose-headings:text-balance"
    >
      <slot />
    </article>
  </div>
</Layout>
